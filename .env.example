# ─── Client (bundled into the web build — anon key only, never the service key) ───
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ─── Server only (Vercel env vars — NOT prefixed EXPO_PUBLIC_, never reaches the client) ───
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Shared secret guarding /api/cron/* — Vercel Cron sends it as the Authorization header.
CRON_SECRET=generate-a-long-random-string

# Apify token for the Airbnb / VRBO adapters. Optional: leave unset and those
# sources stay disabled instead of failing.
APIFY_TOKEN=apify_api_...
